diff --git a/src/websocket.c b/src/websocket.c
index a5369dc..cb8d493 100644
--- a/src/websocket.c
+++ b/src/websocket.c
@@ -819,6 +819,13 @@ static void ws_close_cb(uv_link_t *l) {
     on_ws_close(ws);
 }
 
+static void ws_tr_close_cb(uv_handle_t *handle) {
+    tlsuv_websocket_t *ws = handle->data;
+    tlsuv__free(handle);
+    /* The caller owns ws and may release it from close_cb. */
+    on_ws_close(ws);
+}
+
 int tlsuv_websocket_close(tlsuv_websocket_t *ws, uv_close_cb cb) {
     ws->close_cb = cb;
     ws->closed = true;
@@ -829,6 +836,8 @@ int tlsuv_websocket_close(tlsuv_websocket_t *ws, uv_close_cb cb) {
         tlsuv_connector_req cr = ws->connect_req;
         ws->connect_req = NULL;
         c->cancel(cr);
+        on_ws_close(ws);
+        return 0;
     }
 
     if (ws->src != NULL) {
@@ -840,9 +849,12 @@ int tlsuv_websocket_close(tlsuv_websocket_t *ws, uv_close_cb cb) {
 
     if (ws->tr != NULL) {
         UM_LOG(TRACE, "closing ws transport");
-        ws->tr_close(ws->tr, (uv_close_cb)free);
+        void *tr = ws->tr;
         ws->tr = NULL;
+        ws->tr_close(tr, ws_tr_close_cb);
+        return 0;
     }
+
     on_ws_close(ws);
     return 0;
 }
