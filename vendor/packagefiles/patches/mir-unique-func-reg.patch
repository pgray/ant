+  for (n = 1;; n++) {
+    snprintf (unique, sizeof (unique), "%s.%lu", name, n);
+    if (find_rd_by_name (ctx, unique, func) == NULL) break;
+  }
+  return new_func_reg (ctx, func, type, unique, NULL);
+}
